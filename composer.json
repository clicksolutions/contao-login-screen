{
    "name": "clicksolutions/contao-login-screen",
    "type": "contao-bundle",
    "description": "Customize the Contao back end login screen (logo, background image, text)",
    "license": "GPL-3.0-or-later",
    "authors": [
        {
            "name": "René Fehrmann",
            "homepage": "https://www.click-solutions.de"
        }
    ],
    "require": {
        "php": "^8.3",
        "contao/core-bundle": "^5.7"
    },
    "require-dev": {
        "contao/manager-plugin": "^2.0",
        "phpstan/phpstan": "^2.0",
        "phpunit/phpunit": "^11.5",
        "roave/security-advisories": "dev-latest"
    },
    "conflict": {
        "contao/core": "*",
        "contao/manager-plugin": "<2.0 || >=3.0"
    },
    "autoload": {
        "psr-4": {
            "ClickSolutions\\ContaoLoginScreenBundle\\": "src/"
        },
        "classmap": [
            "contao/"
        ],
        "exclude-from-classmap": [
            "contao/dca/"
        ]
    },
    "extra": {
        "contao-manager-plugin": "ClickSolutions\\ContaoLoginScreenBundle\\ContaoManager\\Plugin"
    },
    "scripts": {
        "stan": "phpstan analyse",
        "test": "phpunit"
    },
    "autoload-dev": {
        "psr-4": {
            "ClickSolutions\\ContaoLoginScreenBundle\\Tests\\": "tests/"
        }
    }
}
